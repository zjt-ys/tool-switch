{
  "name": "dsh-tool-switch",
  "version": "1.1.0",
  "private": false,
  "description": "Switch which tools a conversation can call, from a settings page, from chat, or from the agent — and inject a tool-hygiene prompt policy so the agent prunes unneeded tool families itself.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tool-switch",
    "tool-policy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjt-ys/tool-switch.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./groups": "./groups.js",
    "./store": "./store.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "groups.js",
    "store.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "id": "dsh-tool-switch",
    "name": "工具开关",
    "version": "1.1.0",
    "repo": "zjt-ys/tool-switch",
    "permissions": "工具注册表 restrict、会话命令、设置页 HTTP 路由、系统提示词 section",
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
